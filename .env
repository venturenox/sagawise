# Sagawise security (phase 8, docs/threat-model.md). Dev defaults only:
# every deployment must set its own values.
# API keys clients send as `Authorization: Bearer <key>`; comma-separated.
SAGAWISE_API_KEYS=dev-api-key-change-me
# HMAC secret for failure webhooks (X-Sagawise-Signature). Empty = unsigned.
SAGAWISE_WEBHOOK_SECRET=dev-webhook-secret-change-me
# Browser origins allowed to call the API; empty = none.
SAGAWISE_CORS_ORIGINS=
# Cap on a request body (publish payload). Default 1M.
SAGAWISE_MAX_BODY_BYTES=1M

# Redis envs
REDIS_CONNECTION_STRING=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Postgres envs
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=venturenox
POSTGRES_DATABASE=sagawise
POSTGRES_DATABASE_LIST=auth,intermediate,sagawise

# Adminer envs
ADMINER_PORT=8080
MACHINE_ADMINER_PORT=8090

# Redis Insight Envs
REDIS_INSIGHT_MACHINE_PORT=5540
REDIS_INSIGHT_PORT=5540

