ORDERS_PORT=4010
PAYMENTS_PORT=4011
SHIPPING_PORT=4012

# Kafka. Uses this example's own broker, on its own topic, so it does not
# collide with the api_examples stack.
KAFKA_HOST="order-flow-kafka:9092"
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_EVENT_TOPIC=order_flow_events

# Sagawise credentials: must match SAGAWISE_API_KEYS and SAGAWISE_WEBHOOK_SECRET
# in the root .env (the core stack). Dev values only.
SAGAWISE_API_KEY=dev-api-key-change-me
SAGAWISE_WEBHOOK_SECRET=dev-webhook-secret-change-me
